# Copie para .env e preencha. O .env NUNCA vai para o GitHub.

# development | production
FLASK_ENV=development
FLASK_APP=run.py

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# --- Banco de dados ---
# Docker Compose (o host é o nome do serviço "db"):
# DATABASE_URL=mysql+pymysql://oficios_app:TroqueEstaSenha@db:3306/gestao_oficios?charset=utf8mb4
# XAMPP (MySQL/MariaDB local):
DATABASE_URL=mysql+pymysql://oficios_app:TroqueEstaSenha@127.0.0.1:3306/gestao_oficios?charset=utf8mb4

# Usado só pelo docker-compose.yml
MYSQL_ROOT_PASSWORD=TroqueEstaSenhaRoot
MYSQL_PASSWORD=TroqueEstaSenha

# --- Dados do gabinete (aparecem nos documentos) ---
GABINETE_NOME=Gabinete Exemplo
CIDADE=Cidade Exemplo
RESPONSAVEL_NOME=NOME DO VEREADOR
RESPONSAVEL_CARGO=Vereador
# Primeiro número do ano quando ainda não há ofícios
NUMERACAO_INICIAL=1

# Em produção com HTTPS, ative:
# SESSION_COOKIE_SECURE=1
